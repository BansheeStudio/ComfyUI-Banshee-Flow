      "nodePath": "2.inputs.clip_name"
    },
    {
      "id": "dropH3vvid",
      "url": "VAELoader",
      "key": "vae_name",
      "label": "Video VAE",
      "nodePath": "3.inputs.vae_name"
    },
    {
      "id": "dropH3vaud",
      "url": "VAELoader",
      "key": "vae_name",
      "label": "Audio VAE",
      "nodePath": "4.inputs.vae_name"
    }
