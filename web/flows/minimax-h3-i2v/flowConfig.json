  "prompts": [
    {
      "id": "promptH3a",
      "label": "Prompt",
      "default": "A white female goat with purple eyes and black horns in a lush jungle slowly turns her head toward the camera and blinks, ears twitching. Gentle breeze rustles the leaves, soft birdsong and jungle ambience, cinematic lighting, high detail.",
